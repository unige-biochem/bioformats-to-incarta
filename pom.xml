<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>45.1.0</version>
		<relativePath />
	</parent>

	<groupId>ch.unige.biochem</groupId>
	<artifactId>bioformats-to-incarta</artifactId>
	<version>0.1.1-SNAPSHOT</version>

	<name>Bio-Formats to IN Carta</name>
	<description>Converts any Bio-Formats supported image file into an IN Carta compatible format.</description>
	<url>https://github.com/unige-biochem/bioformats-to-incarta</url>
	<inceptionYear>2026</inceptionYear>
	<organization>
		<name>University of Geneva, Department of Biochemistry</name>
		<url>https://www.unige.ch/sciences/biochimie/</url>
	</organization>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>NicoKiaru</id>
			<name>Nicolas Chiaruttini</name>
			<url>https://imagej.net/User:NicoKiaru</url>
			<roles>
				<role>founder</role>
				<role>lead</role>
				<role>developer</role>
				<role>debugger</role>
				<role>reviewer</role>
				<role>support</role>
				<role>maintainer</role>
			</roles>
		</developer>
	</developers>
	<contributors>
		<contributor>
			<name>Nicolas Chiaruttini</name>
			<url>https://imagej.net/User:NicoKiaru</url>
			<properties><id>NicoKiaru</id></properties>
		</contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:https://github.com/unige-biochem/bioformats-to-incarta</connection>
		<developerConnection>scm:git:git@github.com:unige-biochem/bioformats-to-incarta</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/unige-biochem/bioformats-to-incarta</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/unige-biochem/bioformats-to-incarta/issues</url>
	</issueManagement>
	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/unige-biochem/bioformats-to-incarta/actions</url>
	</ciManagement>

	<properties>
		<package-name>ch.unige.biochem.incarta</package-name>
		<main-class>ch.unige.biochem.incarta.command.BioformatsToIncartaCommand</main-class>
		<license.licenseName>mit</license.licenseName>
		<license.copyrightOwners>University of Geneva</license.copyrightOwners>

		<!-- NB: Deploy releases to the SciJava Maven repository. -->
		<releaseProfiles>sign,deploy-to-scijava</releaseProfiles>
	</properties>

	<dependencies>

		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>imagej</artifactId>
		</dependency>

		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-common</artifactId>
		</dependency>

		<!-- Bio-Formats: reading side. formats-gpl brings in formats-api and
		     formats-bsd transitively, plus every proprietary reader. -->
		<dependency>
			<groupId>ome</groupId>
			<artifactId>formats-gpl</artifactId>
		</dependency>

		<!-- Runtime dependencies -->

		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>imagej-legacy</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Test scope dependencies -->

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<!--
					NB: Keep every dependency on the classpath rather than the module
					path. Bio-Formats pulls in ome:turbojpeg, whose TJExample.class
					sits in the default package, so javadoc cannot derive a module
					descriptor for it and the attach-javadocs execution of a release
					build fails.
					-->
					<legacyMode>true</legacyMode>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>
</project>
